
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #0b0f19;
    color: white;
}

.app {
    display: flex;
    height: 100vh;
}


/* SIDEBAR */

.sidebar {
    width: 260px;
    background: #111827;
    padding: 25px;
    border-right: 1px solid #263244;
}

.sidebar h1 {
    color: #00e5ff;
    margin-bottom: 8px;
}

.sidebar > p {
    color: #8994a5;
    margin-bottom: 30px;
}

.sidebar button {
    width: 100%;
    padding: 13px;

    border: none;
    border-radius: 8px;

    background: #00bcd4;
    color: white;

    cursor: pointer;
    font-size: 15px;
}

.sidebar button:hover {
    background: #0097a7;
}

.features {
    margin-top: 40px;
}

.features h3 {
    color: #64748b;
    margin-bottom: 15px;
}

.features p {
    padding: 10px 0;
    color: #cbd5e1;
}


/* MAIN */

.main {
    flex: 1;
    display: flex;
    flex-direction: column;
}


/* HEADER */

.header {
    height: 75px;

    display: flex;
    align-items: center;

    padding: 15px 30px;

    background: #0f1522;

    border-bottom: 1px solid #263244;
}

.header h2 {
    margin-bottom: 4px;
}

.header span {
    color: #22c55e;
    font-size: 13px;
}


/* CHAT */

.chat-box {
    flex: 1;

    padding: 30px;

    overflow-y: auto;
}

.message {
    display: flex;

    gap: 12px;

    margin-bottom: 25px;

    max-width: 800px;
}

.avatar {
    min-width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #172033;

    border-radius: 50%;
}

.bubble {
    background: #151e2d;

    padding: 15px 18px;

    border-radius: 12px;

    line-height: 1.6;
}

.bubble strong {
    color: #00e5ff;
}

.bubble p {
    margin-top: 8px;
}


/* USER MESSAGE */

.message.user {
    margin-left: auto;

    flex-direction: row-reverse;
}

.message.user .bubble {
    background: #006d7a;
}

.message.user .bubble strong {
    color: white;
}


/* SUGGESTIONS */

.suggestions {
    display: flex;

    gap: 10px;

    padding: 10px 30px;

    overflow-x: auto;
}

.suggestions button {
    padding: 9px 14px;

    background: #151e2d;

    border: 1px solid #334155;

    color: #cbd5e1;

    border-radius: 20px;

    cursor: pointer;

    white-space: nowrap;
}

.suggestions button:hover {
    border-color: #00e5ff;
    color: #00e5ff;
}


/* INPUT */

.input-area {
    display: flex;

    gap: 10px;

    padding: 20px 30px;

    border-top: 1px solid #263244;
}

.input-area input {
    flex: 1;

    padding: 15px;

    background: #151e2d;

    border: 1px solid #334155;

    border-radius: 10px;

    color: white;

    font-size: 15px;

    outline: none;
}

.input-area input:focus {
    border-color: #00e5ff;
}

.input-area button {
    width: 55px;

    border: none;

    border-radius: 10px;

    background: #00bcd4;

    color: white;

    font-size: 20px;

    cursor: pointer;
}


/* MOBILE */

@media (max-width: 700px) {

    .sidebar {
        display: none;
    }

    .chat-box {
        padding: 15px;
    }

    .input-area {
        padding: 12px;
    }

}
